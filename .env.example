# PAYPAD — every value here is unset by default, and the site is built to be
# honest about that: no factory address means every launch control on the site
# stays interlocked, and the registry reads zero because it read zero.
#
# Copy to `.env.local` and fill in only what is actually true.

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=

# --- Chain ------------------------------------------------------------------
# Defaults are Robinhood Chain mainnet, probed 2026-09-02: chain id 4663
# (0x1237) and a live RPC. Override only with values you have checked.
NEXT_PUBLIC_ROBINHOOD_CHAIN_ID=
NEXT_PUBLIC_ROBINHOOD_RPC_URL=
NEXT_PUBLIC_ROBINHOOD_EXPLORER_URL=

# --- Launch surface ---------------------------------------------------------
# `LIVE` alone does nothing: the factory address must exist too, or `isLive`
# stays false. A wrong address here does not misprint a page — it takes a real
# deployment transaction and every fee that follows it.
NEXT_PUBLIC_PAYPAD_LIVE=
NEXT_PUBLIC_PAYPAD_FACTORY_ADDRESS=
NEXT_PUBLIC_PAYPAD_TREASURY_ADDRESS=
NEXT_PUBLIC_PAYPAD_DEPLOYMENT_BLOCK=
NEXT_PUBLIC_PAYPAD_SOURCE_URL=
NEXT_PUBLIC_PAYPAD_AUDIT_URL=

# --- Payout registry --------------------------------------------------------
# Comma-separated, each entry `SYMBOL:Name:0xaddress`. Empty by default: no
# tokenized equity has been verified on this chain from here, and a pad buys
# whatever contract it is handed. A malformed entry is dropped, not guessed at.
NEXT_PUBLIC_PAYPAD_PAYOUT_ASSETS=

# --- Terms ------------------------------------------------------------------
# Basis points. These override the proposed terms in src/lib/economics.ts, and
# they must match whatever the deployed factory actually enforces — the factory
# is the source of truth, this is only the front end's copy of it.
NEXT_PUBLIC_PAYPAD_MIN_FEE_BPS=
NEXT_PUBLIC_PAYPAD_MAX_FEE_BPS=
NEXT_PUBLIC_PAYPAD_DEFAULT_FEE_BPS=
NEXT_PUBLIC_PAYPAD_PLATFORM_SHARE_BPS=
NEXT_PUBLIC_PAYPAD_MIN_HOLDER_SHARE_BPS=
